<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Launcher-loader shared stuff -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageVersion Include="Splat" Version="21.0.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" Condition="'$(UseSystemSqlite)' != 'True'" />
    <PackageVersion Include="SQLitePCLRaw.provider.sqlite3" Version="3.0.5" Condition="'$(UseSystemSqlite)' == 'True'" />
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0"/>
    <PackageVersion Include="SharpZstd.Interop" Version="1.5.2-beta2"/>
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="10.0.14" />
    <PackageVersion Include="Robust.Natives.Zstd" Version="0.1.1-zstd1.5.7"/>
    <!-- Loader -->
    <PackageVersion Include="Robust.Natives" Version="0.2.7"/>
    <!-- Launcher -->
    <PackageVersion Include="Avalonia" Version="12.1.5"/>
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5"/>
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.22"/>
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.5"/>
    <PackageVersion Include="CodeHollow.FeedReader" Version="2.1.1"/>
    <PackageVersion Include="Dapper" Version="2.1.89"/>
    <PackageVersion Include="DynamicData" Version="9.5.0"/>
    <PackageVersion Include="Microsoft.Toolkit.Mvvm" Version="7.1.2"/>
    <PackageVersion Include="Robust.Shared.AuthLib" Version="0.1.2"/>
    <PackageVersion Include="Serilog" Version="4.4.0"/>
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1"/>
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageVersion Include="YamlDotNet" Version="18.1.0"/>
    <PackageVersion Include="TerraFX.Interop.Windows" Version="10.0.26100.6"/>
    <PackageVersion Include="Mono.Posix.NETStandard" Version="1.0.0"/>
    <PackageVersion Include="SpaceWizards.Sodium" Version="0.3.0"/>
    <PackageVersion Include="libsodium" Version="1.0.22" />
    <PackageVersion Include="System.Net.Http.WinHttpHandler" Version="10.0.14" />
    <PackageVersion Include="Linguini.Bundle" Version="0.11.0" />
    <!-- Test stuff -->
    <PackageVersion Include="nunit" Version="5.0.0"/>
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0"/>
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1"/>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
    <!-- Bootstrap -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"/>
    <!-- Development -->
    <PackageVersion Include="HotAvalonia" Version="3.1.5" />
  </ItemGroup>
</Project>
